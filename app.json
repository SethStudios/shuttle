{
  "expo": {
    "name": "UniAbujaShuttle",
    "slug": "UniAbujaShuttle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uniabujashuttle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uniabujashuttle.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow UniAbuja Shuttle to access your camera to scan rider QR codes at the terminal."
      }
    },
    "android": {
      "package": "com.uniabujashuttle.app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "icon": "./assets/images/icon.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "manifest": {
        "name": "UniAbuja Shuttle",
        "short_name": "Shuttle",
        "description": "UniAbuja campus shuttle booking and boarding",
        "start_url": "/",
        "display": "standalone",
        "background_color": "#2F4035",
        "theme_color": "#2E7D32",
        "orientation": "portrait-primary",
        "icons": [
          {
            "src": "/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
          }
        ]
      },
      "serviceWorker": {
        "src": "./public/sw.js",
        "scope": "/"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow UniAbuja Shuttle to access your camera to scan rider QR codes at the terminal."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2F4035",
          "dark": {
            "backgroundColor": "#0D120F"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2E7D32",
          "defaultChannel": "shuttle-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dba3906b-ab4b-42d4-89b4-e0cbdf65d8b4"
      }
    }
  }
}
