{
  "expo": {
    "name": "UniAbujaShuttle",
    "slug": "UniAbujaShuttle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uniabujashuttle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uniabujashuttle.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow UniAbuja Shuttle to access your camera to scan rider QR codes at the terminal."
      }
    },
    "android": {
      "package": "com.uniabujashuttle.app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "icon": "./assets/images/icon.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow UniAbuja Shuttle to access your camera to scan rider QR codes at the terminal."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2F4035",
          "dark": {
            "backgroundColor": "#0D120F"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2E7D32",
          "defaultChannel": "shuttle-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dba3906b-ab4b-42d4-89b4-e0cbdf65d8b4"
      }
    }
  }
}
